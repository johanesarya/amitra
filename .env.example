# Salin ke .env lalu sesuaikan. File .env tidak boleh di-commit.
SECRET_KEY=ganti-dengan-string-acak-panjang
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Development: SQLite. Staging/produksi: postgres://user:pass@host:5432/si_ami
DATABASE_URL=sqlite:///db.sqlite3

# Login Google (FR-01). Pisahkan beberapa domain dengan koma.
DOMAIN_EMAIL_KAMPUS=gmail.com
# Dari Google Cloud Console; redirect URI: http://localhost:8000/akun/google/login/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (produksi: SMTP Google Workspace). Development: kosongkan EMAIL_BACKEND agar tampil di console.
EMAIL_BACKEND=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=SI-AMI LPM <no-reply@contoh.ac.id>
SITUS_URL=http://localhost:8000

# Antrean (Django-Q2). Kosongkan REDIS_URL di development (pakai database).
REDIS_URL=
Q_WORKERS=2

# WeasyPrint di Windows: pasang MSYS2 lalu `pacman -S mingw-w64-x86_64-pango`
WEASYPRINT_DLL_DIRECTORIES=C:\msys64\mingw64\bin
