# Salin ke .env lalu sesuaikan. File .env tidak boleh di-commit atau dikirim lewat email.
# Nilai di bawah untuk development. Isian produksi dijelaskan di docs/PANDUAN-INSTALASI.md.

# Buat baru untuk setiap server: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=ganti-dengan-string-acak-panjang
# Produksi: False
DEBUG=True
# Produksi: domain aplikasi, mis. amitra.unika.ac.id
ALLOWED_HOSTS=localhost,127.0.0.1
# Alamat dasar untuk tautan di email. Produksi: https://amitra.unika.ac.id
SITUS_URL=http://localhost:8000

# Development: SQLite. Produksi: postgres://amitra:katasandi@127.0.0.1:5432/amitra
DATABASE_URL=sqlite:///db.sqlite3

# Login Google (FR-01). Produksi: unika.ac.id. Pisahkan beberapa domain dengan koma.
DOMAIN_EMAIL_KAMPUS=gmail.com
# Dari Google Cloud Console; redirect URI: <SITUS_URL>/akun/google/login/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email. Kosongkan EMAIL_BACKEND di development agar email tampil di console.
# Produksi: django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=AMITRA LPM <no-reply@contoh.ac.id>

# Antrean (Django-Q2). Kosongkan REDIS_URL untuk memakai database sebagai broker.
# Produksi Linux: redis://127.0.0.1:6379/0 (Redis 6 atau lebih baru)
REDIS_URL=
Q_WORKERS=2

# Produksi di belakang reverse proxy HTTPS (Nginx/IIS): True
PERCAYA_PROXY=False
# Isi bila perlu, mis. https://amitra.unika.ac.id
CSRF_TRUSTED_ORIGINS=
# Hanya berlaku bila DEBUG=False. Matikan sementara bila HTTPS belum siap.
SECURE_SSL_REDIRECT=True
# Isi 31536000 setelah HTTPS stabil.
SECURE_HSTS_SECONDS=0

# Lokasi berkas unggahan dan dokumen. Kosongkan untuk folder media/ di dalam aplikasi.
MEDIA_ROOT=
LOG_LEVEL=WARNING

# WeasyPrint di Windows: pasang MSYS2 lalu `pacman -S mingw-w64-x86_64-pango`
WEASYPRINT_DLL_DIRECTORIES=C:\msys64\mingw64\bin
